# Production/staging environment template for Hermes v2.
# Copy to `.env` on the host that runs `compose.yaml` and fill in real values.
# Never commit the filled-in `.env` — it is gitignored.

PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# --- PostgreSQL ---
# Consumed directly by compose.yaml's postgres service, and folded into
# DATABASE_URL below. Use a strong, generated password — not a dev-style one.
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=

# `postgres` here is the compose service name (Docker's internal DNS), not a
# public host. Keep it that way — Postgres must never be published to the
# host network in production.
DATABASE_URL=postgresql+psycopg://hermes:${POSTGRES_PASSWORD}@postgres:5432/hermes

# --- Administrator bootstrap ---
# The only user the entrypoint grants SUPER_ADMIN to on startup (idempotent).
HERMES_ADMIN_EMAIL=

# --- Google OAuth ---
# From Google Cloud Console credentials for this deployment's OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Google OAuth client,
# and point at this backend's own callback (never the frontend).
GOOGLE_REDIRECT_URI=https://<backend-host>/auth/google/callback

# --- CORS / open-redirect allowlists ---
# Comma-separated, exact-match, no wildcards. Every origin that will call
# this API with credentials (cookies) must be listed here.
HERMES_ALLOWED_ORIGINS=https://<frontend-origin>
# Comma-separated, exact-match. Every frontend URL /auth/google/login is
# allowed to redirect back to after a successful/failed login.
HERMES_ALLOWED_RETURN_URIS=https://<frontend-origin>/login
# Optional: which of the above to use when /auth/google/login is called
# without an explicit return_to. Defaults to the first allowed URI.
HERMES_DEFAULT_RETURN_URI=

# --- Session cookie ---
# Must be "true" in any environment served over HTTPS (i.e. always in
# production). A cookie without Secure can be sent over a plaintext channel.
HERMES_COOKIE_SECURE=true
# "lax" when frontend and backend share a registrable domain (including
# across ports, e.g. Tailscale Serve on two ports of the same host). Use
# "none" only for a genuinely cross-site frontend, and only paired with
# HERMES_COOKIE_SECURE=true — browsers reject SameSite=None without Secure.
HERMES_COOKIE_SAMESITE=lax
# Session lifetime in seconds. Defaults to 86400 (24h) if unset.
HERMES_SESSION_TTL_SECONDS=86400

# --- Rate limiting ---
# Controls which IP the auth-endpoint rate limiter (auth/rate_limiting.py)
# uses to identify a caller. Leave unset/false in the overwhelming majority
# of deployments, including ROMEO today: the default uses the direct TCP
# peer address, which is correct whenever Hermes is not sitting behind a
# reverse proxy that rewrites the source IP.
#
# Only set this to "true" if Hermes is deployed behind a reverse proxy you
# trust to set X-Forwarded-For correctly and to strip/overwrite any
# X-Forwarded-For a client tries to send itself (e.g. a properly configured
# Tailscale Serve, nginx, or load balancer positioned so the app can only
# ever be reached through it). Enabling this incorrectly — or when no such
# proxy is in front of Hermes — lets any caller forge X-Forwarded-For to
# spoof the IP the rate limiter keys on, resetting their own limit for free.
HERMES_TRUST_PROXY_HEADERS=false

# --- Binance (READ+WRITE, Phase 2: feature/binance-trading-integration-v1) ---
# Read by src/hermes_v2/integrations/binance.py. Withdrawals, transfers, and
# deposit-address management still don't exist anywhere in this codebase —
# see that file's docstring. Order placement/cancellation now exists, but
# ONLY OrderService (src/hermes_v2/trading/order_service.py) ever calls it —
# no HTTP route calls BinanceClient directly — and every order still passes
# through the TRADING_ENABLED kill switch below before anything reaches
# Binance. `hermes binance-check` remains 100% read-only.
#
# Before setting a real value:
#   - Create a dedicated Binance API key with withdrawals disabled and an
#     IP allowlist restricted to ROMEO's egress IP (Binance account
#     console setting, not something set here) — `make binance-check`'s
#     final "Permissions" line fails the diagnostic if withdrawals are
#     left enabled on the key it's given.
#   - Set both values directly in ROMEO's `/opt/hermes-v2/.env` — never in
#     this repo, never in any CI secret, never in the frontend's env.
#   - See docs/security/secrets-management.md for the full rotation and
#     handling procedure.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional. Defaults to https://api.binance.com — override only to point at
# Binance's testnet or an equivalent for non-production verification.
# BINANCE_BASE_URL=

# --- Trading kill switch and risk limits (Phase 2) ---
# See docs/architecture/trading.md for the full activation runbook.
#
# The global kill switch (src/hermes_v2/trading/config.py). Defaults to
# false and MUST default to false in every deployment — nothing in this
# codebase ever sets it to true automatically (not docker compose up, not a
# migration, not a deploy). An operator sets it explicitly, after reviewing
# what they're enabling.
TRADING_ENABLED=false

# RiskEngine limits (src/hermes_v2/trading/risk_engine.py). Every order is
# rejected until ALL SIX of these are set — this is the intended fail-closed
# default, not a bug. No default values are provided here on purpose: an
# operator must decide, for their own account, what "too much" means.
# HERMES_RISK_MAX_ORDER_NOTIONAL_USD=
# HERMES_RISK_MAX_SYMBOL_EXPOSURE_PCT=
# HERMES_RISK_MAX_TOTAL_EXPOSURE_PCT=
# HERMES_RISK_MAX_DAILY_LOSS_PCT=
# HERMES_RISK_MAX_OPEN_POSITIONS=
# HERMES_RISK_ALLOWED_SYMBOLS=
