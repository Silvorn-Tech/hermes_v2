# Local development only. Do not commit a real .env.dev file.
DATABASE_URL=postgresql+psycopg://hermes:replace-with-local-password@127.0.0.1:5432/hermes
HERMES_ADMIN_EMAIL=admin@example.com

# From a Google Cloud Console OAuth client configured for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend dev server origin(s) allowed to call this API with credentials,
# and the exact URL(s) it may be redirected back to after login.
HERMES_ALLOWED_ORIGINS=http://localhost:8081
HERMES_ALLOWED_RETURN_URIS=http://localhost:8081/login

# Local HTTP has no TLS, so the cookie cannot be Secure; SameSite=lax is
# enough since the dev frontend and backend share localhost as a site.
HERMES_COOKIE_SECURE=false
HERMES_COOKIE_SAMESITE=lax

# Only needed to run `make binance-check` locally, or to exercise the
# trading endpoints against Binance's testnet. Use a dedicated key with
# withdrawals disabled — never a production Binance key in a dev file.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_BASE_URL=

# Trading kill switch — defaults to false. Leave unset/false for local dev
# unless you're deliberately exercising the live order-execution path
# against Binance's testnet with a dedicated testnet key.
TRADING_ENABLED=false

# RiskEngine limits — every order is rejected until all six are set. Example
# permissive dev values; do not reuse these for a production deployment.
# HERMES_RISK_MAX_ORDER_NOTIONAL_USD=100
# HERMES_RISK_MAX_SYMBOL_EXPOSURE_PCT=50
# HERMES_RISK_MAX_TOTAL_EXPOSURE_PCT=80
# HERMES_RISK_MAX_DAILY_LOSS_PCT=10
# HERMES_RISK_MAX_OPEN_POSITIONS=5
# HERMES_RISK_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
